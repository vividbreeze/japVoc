generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id              String   @id @default(uuid())
  hiragana        String
  katakana        String?
  kanji           String?
  romaji          String?
  deutsch         String
  beispielsatz_jp String?
  beispielsatz_de String?
  wortart         String
  jlpt_level      String   @default("N5")
  createdAt       DateTime @default(now())

  collections CollectionWord[]
  reviews     Review[]
  progress    WordProgress?
}

model Collection {
  id           String   @id @default(uuid())
  name         String
  beschreibung String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  words CollectionWord[]
}

model CollectionWord {
  collectionId String
  wordId       String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  word       Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([collectionId, wordId])
}

model Review {
  id             String   @id @default(uuid())
  wordId         String
  reviewedAt     DateTime @default(now())
  rating         Int
  repetitions    Int
  easinessFactor Float
  intervalDays   Int
  nextReviewDate DateTime

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model WordProgress {
  id             String   @id @default(uuid())
  wordId         String   @unique
  repetitions    Int      @default(0)
  easinessFactor Float    @default(2.5)
  intervalDays   Int      @default(0)
  nextReviewDate DateTime @default(now())
  updatedAt      DateTime @updatedAt

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Settings {
  id                  String  @id @default("default")
  lernrichtung        String  @default("jp_to_de")  // "jp_to_de" | "de_to_jp"
  // Japanese side: shown on front (jp_to_de) or back (de_to_jp)
  frontShowHiragana   Boolean @default(true)
  frontShowKanji      Boolean @default(false)
  frontShowRomaji     Boolean @default(false)
  frontShowExampleJp  Boolean @default(false)
  // German side
  showExampleSentence Boolean @default(true)
  // 0 = unlimited
  newWordsPerDay      Int     @default(20)
}

model LearningDay {
  id        String   @id @default(uuid())
  date      String   @unique
  cardsStudied Int   @default(0)
  createdAt DateTime @default(now())
}
